<!--
  Rules for the macos-* decoders (macOS Unified Logging System, native
  `macos` log format). See decoders/macos_uls.xml.
  Astier Consulting - Jul 2026
  Rule IDs: 101150-101179

  Signal covered (matches the ULS query predicate pushed to the macOS agent
  group): MDM/ManagedClient (profile changes, destructive commands),
  Gatekeeper/syspolicy (denied assessments), XProtect (malware detection),
  opendirectoryd (authentication), application firewall, package installs.
  sudo/sshd/tccd/screensharingd/securityd keep flowing to the stock
  decoders/rules (0580-macos_decoders.xml).
-->
<group name="macos,">

  <!-- ===== MDM (Jamf-managed fleet): mdmclient / ManagedClient ===== -->
  <rule id="101151" level="1">
    <decoded_as>macos-mdmclient</decoded_as>
    <description>macOS MDM: $(macos.category) activity</description>
    <group>mdm,</group>
  </rule>

  <rule id="101152" level="5">
    <if_sid>101151</if_sid>
    <!-- Space before "profile" required: excludes XPC chatter like
         "### XPC request: GetInstalledProfiles ###" -->
    <field name="macos.event" type="pcre2">(?i)(?:install(?:ed|ing)?|remov(?:ed|ing)|delet(?:ed|ing)) (?:configuration )?profile</field>
    <description>macOS MDM: configuration profile change — $(macos.event)</description>
    <mitre>
      <id>T1484</id>
    </mitre>
    <group>mdm,config_changed,pci_dss_10.2.7,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.14,tsc_CC6.8,tsc_CC8.1,</group>
  </rule>

  <rule id="101153" level="10">
    <if_sid>101151</if_sid>
    <field name="macos.event" type="pcre2">(?i)EraseDevice|DeviceLock|RemoteWipe|EnableLostMode</field>
    <description>macOS MDM: DESTRUCTIVE command received — $(macos.event)</description>
    <mitre>
      <id>T1561</id>
    </mitre>
    <group>mdm,pci_dss_10.2.7,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_SI.4,tsc_CC6.8,tsc_A1.2,</group>
  </rule>

  <!-- ===== Gatekeeper / syspolicy ===== -->
  <rule id="101155" level="3">
    <decoded_as>macos-syspolicyd</decoded_as>
    <description>macOS Gatekeeper/syspolicy: $(macos.event)</description>
    <group>gatekeeper,</group>
  </rule>

  <rule id="101156" level="8">
    <if_sid>101155</if_sid>
    <field name="macos.event" type="pcre2">(?i)denied|reject</field>
    <description>macOS Gatekeeper: assessment DENIED — $(macos.event)</description>
    <mitre>
      <id>T1204.002</id>
    </mitre>
    <group>gatekeeper,access_denied,pci_dss_10.6.1,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_SI.4,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- ===== XProtect (malware detection / remediation) =====
       Base at L0: XProtect is extremely chatty (XProtectBridgeService
       behavior telemetry, "Dropping <private>", "Unhandled type"...) — the
       signal lives in the children, the base is archive-only (was L3 →
       44k events/day polluting Threat Hunting). -->
  <rule id="101157" level="0">
    <decoded_as>macos-xprotect</decoded_as>
    <description>macOS XProtect: activity — $(macos.event)</description>
    <group>xprotect,</group>
  </rule>

  <!-- Routine scan chatter + CLEAN reports (traced at L1): plugin
       enumeration ("Found/Discovered remediator") AND the standard
       remediator report "XProtectPlugin completed with status: N" and any
       "no threat/malware" line. Lesson: "No threat DETECTED" and the binary
       names ("...Remediator") both trip loose keyword matchers — pin them
       here, not in the L12 rule. -->
  <rule id="101159" level="1">
    <if_sid>101157</if_sid>
    <field name="macos.event" type="pcre2">(?i)^(?:Found (?:XProtect plugin|remediator)|Discovered remediator|Ignoring|Skipping|XProtectPlugin completed)|\bno (?:threat|malware)\b</field>
    <description>macOS XProtect: routine scan / clean report (no threat)</description>
    <group>xprotect,</group>
  </rule>

  <!-- Real detection ONLY: positive detection/remediation language with a
       negative lookahead excluding "no threat/malware" (the clean report).
       Bare "detected"/"threat" removed — they matched "No threat detected". -->
  <rule id="101158" level="12">
    <if_sid>101157</if_sid>
    <field name="macos.event" type="pcre2">(?i)^(?!.*\bno (?:threat|malware)\b)(?=.*(?:\bmalware\b|\btrojan\b|\badware\b|\beliminated\b|quarantin|threat (?:detected|found|present)|\binfected\b|remediat(?:ed|ing))).+</field>
    <description>macOS XProtect: MALWARE detected/remediated — $(macos.event)</description>
    <mitre>
      <id>T1204.002</id>
    </mitre>
    <group>xprotect,virus,pci_dss_11.4,pci_dss_5.1,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_SI.3,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- ===== Directory services authentication (opendirectoryd) ===== -->
  <rule id="101160" level="1">
    <decoded_as>macos-opendirectoryd</decoded_as>
    <description>macOS opendirectoryd: $(macos.event)</description>
    <group>authentication,</group>
  </rule>

  <!-- Child of stock 2501 ("syslog: User authentication failure"), not of
       101160: the stock generic rule is evaluated first and wins the event,
       so we refine it — the macos.subsystem field (set by our decoder)
       scopes the refinement to opendirectoryd events only -->
  <rule id="101161" level="5">
    <if_sid>2501</if_sid>
    <field name="macos.subsystem" type="pcre2">^com\.apple\.opendirectoryd$</field>
    <description>macOS: authentication FAILED (opendirectoryd) — $(macos.event)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,gdpr_IV_35.7.d,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <rule id="101162" level="10" frequency="8" timeframe="240">
    <if_matched_sid>101161</if_matched_sid>
    <description>macOS: possible local auth brute force (8+ opendirectoryd failures in 4 min)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,pci_dss_10.2.4,pci_dss_10.2.5,pci_dss_11.4,gdpr_IV_35.7.d,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- ===== Application firewall ===== -->
  <rule id="101166" level="3">
    <decoded_as>macos-socketfilterfw</decoded_as>
    <description>macOS application firewall (socketfilterfw): event</description>
    <group>firewall,pci_dss_10.6.1,gdpr_IV_35.7.d,nist_800_53_AU.6,tsc_CC6.8,</group>
  </rule>

  <!-- ===== Package installs (software inventory trail) ===== -->
  <rule id="101168" level="3">
    <decoded_as>macos-installd</decoded_as>
    <description>macOS installd: package event</description>
    <group>software_install,pci_dss_10.6.1,gdpr_IV_35.7.d,nist_800_53_AU.6,tsc_CC6.8,</group>
  </rule>

  <!-- ===== Jamf Protect (EDR) ===== -->
  <rule id="101175" level="1">
    <decoded_as>macos-jamfprotect</decoded_as>
    <description>Jamf Protect: $(macos.category) activity</description>
    <group>jamf_protect,</group>
  </rule>

  <rule id="101176" level="9">
    <if_sid>101175</if_sid>
    <field name="macos.event" type="pcre2">(?i)\bthreat\b|\bdetected\b|\bprevent(?:ed)?\b|\bblocked\b|malicious|\bquarantin</field>
    <description>Jamf Protect: THREAT signal — $(macos.event)</description>
    <mitre>
      <id>T1204</id>
    </mitre>
    <group>jamf_protect,attack,pci_dss_11.4,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_SI.3,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- ===== Jamf Pro agent (/var/log/jamf.log — policy execution trail) ===== -->
  <rule id="101170" level="1">
    <decoded_as>macos-jamf</decoded_as>
    <description>Jamf Pro agent: $(jamf.event)</description>
    <group>jamf,</group>
  </rule>

  <rule id="101171" level="3">
    <if_sid>101170</if_sid>
    <field name="jamf.event" type="pcre2">(?i)^Executing Policy</field>
    <description>Jamf Pro: policy executed — $(jamf.event)</description>
    <group>jamf,config_changed,pci_dss_10.6.1,gdpr_IV_35.7.d,nist_800_53_AU.6,tsc_CC6.8,</group>
  </rule>

  <rule id="101172" level="5">
    <if_sid>101170</if_sid>
    <field name="jamf.event" type="pcre2">(?i)error|failed|could not|unable to</field>
    <description>Jamf Pro agent: ERROR — $(jamf.event)</description>
    <group>jamf,system_error,gpg13_4.3,gdpr_IV_35.7.d,</group>
  </rule>

  <!-- Jamf binary via ULS (com.jamf.management.binary) -->
  <rule id="101173" level="1">
    <decoded_as>macos-jamf-uls</decoded_as>
    <description>Jamf binary (ULS): $(jamf.event)</description>
    <group>jamf,</group>
  </rule>

  <rule id="101174" level="5">
    <if_sid>101173</if_sid>
    <field name="jamf.event" type="pcre2">(?i)error|failed|could not|unable to</field>
    <description>Jamf binary (ULS): ERROR — $(jamf.event)</description>
    <group>jamf,system_error,gpg13_4.3,gdpr_IV_35.7.d,</group>
  </rule>

  <!-- ===== Catch-all: every remaining decoded ULS event, archive only ===== -->
  <rule id="101178" level="0">
    <decoded_as>macos-uls-orphan</decoded_as>
    <description>macOS ULS (uncategorized): $(macos.subsystem)/$(macos.category)</description>
    <group>macos_uls,</group>
  </rule>

</group>
