<!-- ═══════════════════════════════════════════════════════════
  zz_ac_nic_watchdog_rules.xml — remontée SIEM du watchdog NIC du nœud (exemple : lien 10G Thunderbolt)
  (logger -t ac-nic-watchdog en priorité warning → journald → agent Wazuh).
  Préfixe zz_ : chargé APRÈS les règles journald de base dont il dérive
  (cf. reference_wazuh_rules_load_order_ifsid).
  Matching journald : <program_name> (OS_Regex), comme les règles PVE/PBS
  qui marchent — PAS decoded_as json.
  IDs réservés : 101320-101329.
═══════════════════════════════════════════════════════════ -->
<group name="ac_nic_watchdog,proxmox,">

  <!-- Base : toute ligne du watchdog (program_name = tag syslog) -->
  <rule id="101320" level="3">
    <program_name>^ac-nic-watchdog$</program_name>
    <description>NIC-watchdog : surveillance du lien 10G (nœud porté par agent.name)</description>
    <group>pci_dss_10.6.1,nist_800_53_AU.6,tsc_A1.2,</group>
  </rule>

  <!-- Remédiation DÉCLENCHÉE (perte LAN confirmée, mode armé) -->
  <rule id="101321" level="8">
    <if_sid>101320</if_sid>
    <match>ALERT perte LAN</match>
    <description>NIC-watchdog : remédiation déclenchée (perte LAN confirmée)</description>
    <group>service_availability,pci_dss_10.6.1,tsc_A1.2,</group>
  </rule>

  <!-- Récupération réussie (à quel barreau) -->
  <rule id="101322" level="5">
    <if_sid>101320</if_sid>
    <match>OK récupéré</match>
    <description>NIC-watchdog : lien 10G récupéré automatiquement</description>
    <group>service_availability,</group>
  </rule>

  <!-- Mode OBSERVATION : le drop s'est reproduit, remédiation NON exécutée
       (la détection a fonctionné — signal pour armer le watchdog) -->
  <rule id="101324" level="7">
    <if_sid>101320</if_sid>
    <match>DRYRUN perte LAN</match>
    <description>NIC-watchdog : DROP DÉTECTÉ en mode observation — remédiation non exécutée</description>
    <group>service_availability,pci_dss_10.6.1,tsc_A1.2,</group>
  </rule>

  <!-- ÉCHEC TOTAL : tous les barreaux ont échoué → intervention physique -->
  <rule id="101323" level="12">
    <if_sid>101320</if_sid>
    <match>CRIT remédiation</match>
    <description>NIC-watchdog : remédiation ÉCHOUÉE — intervention physique requise</description>
    <group>service_availability,pci_dss_10.6.1,nist_800_53_SI.4,tsc_A1.2,</group>
  </rule>

</group>
