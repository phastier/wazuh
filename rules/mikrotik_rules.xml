<!--
  MikroTik RouterOS Rules for Wazuh
  Astier Consulting - Feb 2026
  Rule IDs: 100200-100299
-->
<group name="mikrotik,">

  <!-- ================================ -->
  <!-- FIREWALL RULES                   -->
  <!-- ================================ -->

  <rule id="100200" level="3">
    <decoded_as>mikrotik-fw-drop-ipv4-parent</decoded_as>
    <description>MikroTik: Firewall DROP IPv4 - $(protocol) $(srcip):$(srcport) -> $(dstip):$(dstport)</description>
    <group>mikrotik,firewall,drop,firewall_drop,pci_dss_10.6.1,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,</group>
  </rule>

  <rule id="100201" level="3">
    <decoded_as>mikrotik-fw-drop-ipv6-parent</decoded_as>
    <description>MikroTik: Firewall DROP IPv6 - $(protocol) $(srcip) -> $(dstip)</description>
    <group>mikrotik,firewall,drop,ipv6,firewall_drop,pci_dss_10.6.1,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,</group>
  </rule>

  <rule id="100202" level="4">
    <decoded_as>mikrotik-fw-invalid-parent</decoded_as>
    <description>MikroTik: Invalid forward - $(protocol) $(srcip):$(srcport) -> $(dstip):$(dstport)</description>
    <group>mikrotik,firewall,invalid,firewall_drop,pci_dss_10.6.1,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,</group>
  </rule>

  <!-- DROP INPUT: traffic directed at the router itself -->
  <rule id="100203" level="6">
    <if_sid>100200</if_sid>
    <match>INPUT</match>
    <description>MikroTik: Firewall DROP INPUT (traffic to router) - $(protocol) $(srcip):$(srcport) -> $(dstip):$(dstport)</description>
    <group>mikrotik,firewall,drop,input,firewall_drop,pci_dss_10.6.1,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,</group>
  </rule>

  <rule id="100204" level="6">
    <if_sid>100201</if_sid>
    <match>INPUT</match>
    <description>MikroTik: Firewall DROP INPUT IPv6 (traffic to router) - $(protocol) $(srcip):$(srcport) -> $(dstip):$(dstport)</description>
    <group>mikrotik,firewall,drop,input,firewall_drop,pci_dss_10.6.1,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,</group>
  </rule>

  <!-- MNDP (MikroTik neighbor discovery, udp/5678) broadcast hitting the
       router: pure LAN chatter, traced without alerting — the real fix is
       restricting /ip neighbor discovery-settings at the source -->
  <rule id="100205" level="1">
    <if_sid>100203,100204</if_sid>
    <match>:5678, len </match>
    <description>MikroTik: MNDP discovery broadcast dropped (in:$(srcintf))</description>
    <group>mikrotik,firewall,drop,input,mndp,</group>
  </rule>

  <!-- High frequency DROP from same source -->
  <rule id="100210" level="8" frequency="20" timeframe="60">
    <if_matched_sid>100200</if_matched_sid>
    <same_srcip />
    <description>MikroTik: Multiple firewall DROPs from $(srcip) - possible scan</description>
    <mitre>
      <id>T1595</id>
    </mitre>
    <group>mikrotik,firewall,attack,multiple_drops,recon,pci_dss_1.4,pci_dss_10.6.1,pci_dss_11.4,gdpr_IV_35.7.d,hipaa_164.312.a.1,hipaa_164.312.b,nist_800_53_SC.7,nist_800_53_AU.6,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <rule id="100211" level="8" frequency="20" timeframe="60">
    <if_matched_sid>100202</if_matched_sid>
    <same_srcip />
    <description>MikroTik: Multiple invalid forwards from $(srcip)</description>
    <group>mikrotik,firewall,attack,multiple_drops,pci_dss_1.4,pci_dss_10.6.1,gdpr_IV_35.7.d,hipaa_164.312.a.1,hipaa_164.312.b,nist_800_53_SC.7,nist_800_53_AU.6,</group>
  </rule>

  <!-- ================================ -->
  <!-- AUTHENTICATION RULES             -->
  <!-- ================================ -->

  <rule id="100220" level="5">
    <decoded_as>mikrotik-login-parent</decoded_as>
    <match>logged in</match>
    <description>MikroTik: User '$(srcuser)' logged in from $(srcip) via $(protocol)</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>mikrotik,authentication,login,authentication_success,pci_dss_10.2.5,gpg13_7.1,gpg13_7.2,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>


  <!-- User logout -->
  <rule id="100223" level="3">
    <decoded_as>mikrotik-login-parent</decoded_as>
    <match>logged out</match>
    <description>MikroTik: User '$(srcuser)' logged out from $(srcip) via $(protocol)</description>
    <group>mikrotik,authentication,logout,authentication_success,pci_dss_10.2.5,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- Login from non-RFC1918 address -->
  <rule id="100221" level="10">
    <if_sid>100220</if_sid>
    <regex type="pcre2">logged in from (?!10\.|172\.(1[6-9]|2\d|3[01])\.|192\.168\.)</regex>
    <description>MikroTik: Login from EXTERNAL IP $(srcip) by '$(srcuser)' via $(protocol)</description>
    <mitre>
      <id>T1133</id>
    </mitre>
    <group>mikrotik,authentication,login,external,authentication_success,pci_dss_10.2.5,gpg13_7.1,gpg13_7.2,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- Multiple logins -->
  <rule id="100222" level="8" frequency="5" timeframe="120">
    <if_matched_sid>100220</if_matched_sid>
    <same_srcip />
    <description>MikroTik: Multiple login attempts from $(srcip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>mikrotik,authentication,brute_force,authentication_failures,pci_dss_10.2.4,pci_dss_10.2.5,pci_dss_11.4,gpg13_7.1,gdpr_IV_35.7.d,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,nist_800_53_SI.4,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <!-- ================================ -->
  <!-- DHCP RULES                       -->
  <!-- ================================ -->

  <rule id="100230" level="3">
    <decoded_as>mikrotik-dhcp-send-parent</decoded_as>
    <description>MikroTik: DHCP $(action) to $(dstip) on $(srcintf)</description>
    <group>mikrotik,dhcp,</group>
  </rule>

  <rule id="100231" level="3">
    <decoded_as>mikrotik-dhcp-recv-parent</decoded_as>
    <description>MikroTik: DHCP $(action) received</description>
    <group>mikrotik,dhcp,</group>
  </rule>

  <rule id="100232" level="3">
    <decoded_as>mikrotik-dhcp-lease-parent</decoded_as>
    <description>MikroTik: DHCP lease event</description>
    <group>mikrotik,dhcp,lease,</group>
  </rule>

  <rule id="100233" level="4">
    <decoded_as>mikrotik-dhcp-removing-parent</decoded_as>
    <description>MikroTik: DHCP lease removed - $(dstip) $(dstuser)</description>
    <group>mikrotik,dhcp,lease_removal,</group>
  </rule>

  <!-- ================================ -->
  <!-- SYSTEM RULES                     -->
  <!-- ================================ -->

  <rule id="100240" level="3">
    <decoded_as>mikrotik-system-parent</decoded_as>
    <description>MikroTik: System event</description>
    <group>mikrotik,system,</group>
  </rule>

  <!-- Netwatch probe scripts (ping / ping done): telemetry, traced without
       alerting — they otherwise drown the system events they share a rule
       with -->
  <rule id="100241" level="1">
    <if_sid>100240</if_sid>
    <match>^ping</match>
    <description>MikroTik: netwatch probe</description>
    <group>mikrotik,system,netwatch,</group>
  </rule>

  <!-- RouterOS package installed (upgrade trail). RouterOS buffers boot-time
       messages and delivers them once links are back up. -->
  <rule id="100242" level="5">
    <if_sid>100240</if_sid>
    <match>^installed |^upgraded </match>
    <description>MikroTik: RouterOS package installed (upgrade)</description>
    <group>mikrotik,system,upgrade,config_changed,pci_dss_10.2.7,pci_dss_10.6.1,gpg13_4.10,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,nist_800_53_AU.14,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,tsc_CC8.1,</group>
  </rule>

  <!-- Router reboot: the raw log carries who/why
       (e.g. "router rebooted by tcp-msg(winbox):admin@host/upgrade") -->
  <!-- Covers "router rebooted by <actor>/<reason>" AND "router was rebooted
       without proper shutdown" (power loss / crash) -->
  <rule id="100243" level="8">
    <if_sid>100240</if_sid>
    <match>rebooted</match>
    <description>MikroTik: ROUTER REBOOTED (actor/reason in the raw log)</description>
    <group>mikrotik,system,reboot,config_changed,service_availability,pci_dss_10.2.7,pci_dss_10.6.1,gpg13_4.10,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.6,nist_800_53_AU.14,tsc_A1.2,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,tsc_CC8.1,</group>
  </rule>

</group>
